{
  "name": "omegazip-app",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "audit:deps": "bash scripts/security-audit.sh",
    "test:context-menu": "bash scripts/test-context-menu-logic.sh",
    "test:bench-ci": "bash scripts/qa03-benchmark-ci.sh",
    "measure:oz-advantage": "bash scripts/measure-oz-advantage.sh",
    "measure:oz-repo-corpora": "bash scripts/measure-oz-repo-corpora.sh",
    "measure:profile-smoke": "bash scripts/profile-compress-heavy-smoke.sh",
    "measure:competitive": "bash scripts/measure-competitive-bench.sh",
    "measure:baseline-local": "bash scripts/baseline-all-local.sh",
    "measure:everything-local": "bash scripts/run-full-local-qa.sh",
    "measure:release-readiness": "RELEASE_MODE=local bash scripts/release-readiness-local.sh",
    "measure:release-readiness:public": "RELEASE_MODE=public bash scripts/release-readiness-local.sh",
    "measure:kpi-check": "bash scripts/kpi-check-local.sh",
    "measure:release-gate-strict": "RELEASE_MODE=public bash scripts/release-gate-strict.sh",
    "measure:release-gate-local": "RELEASE_MODE=local bash scripts/release-gate-strict.sh",
    "measure:record-clean-machine-smoke": "bash scripts/record-clean-machine-smoke.sh",
    "measure:checklist-d": "bash scripts/checklist-d-automated.sh",
    "test:archive-hardening": "cargo test -p omegazip --test archive_hardening",
    "tauri": "tauri",
    "tauri:prepare-sidecar": "node scripts/prepare-omegazip-sidecar.cjs",
    "build": "npm run tauri:prepare-sidecar && tauri build",
    "build:macos": "npm run tauri:prepare-sidecar && env -u CI npx tauri build",
    "build:macos:with-nsservices": "npm run tauri:prepare-sidecar && env -u CI npx tauri build && bash scripts/inject-macos-services.sh",
    "dev": "tauri dev",
    "android:init": "cargo tauri android init",
    "android:dev": "cargo tauri android dev",
    "android:build": "cargo tauri android build",
    "android:open": "cargo tauri android dev --open"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "2.6.0"
  }
}
