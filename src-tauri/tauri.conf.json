{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmegaZip",
  "version": "0.4.0",
  "identifier": "app.omegazip.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OmegaZip",
        "width": 540,
        "height": 580,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": "entitlements/macos-release.plist",
      "infoPlist": "Info.plist"
    },
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "Utility",
    "shortDescription": "Archive and extract .oz files. Windows, macOS, Linux. Built-in rclone.",
    "longDescription": "OmegaZip — кросс-платформенный архиватор с 4-этапным пайплайном сжатия и интеграцией rclone для облачного бэкапа. Windows, macOS, Linux.",
    "fileAssociations": [
      {
        "ext": ["oz"],
        "description": "OmegaZip Archive",
        "role": "Viewer"
      },
      {
        "ext": ["zip"],
        "description": "ZIP Archive",
        "role": "Viewer"
      },
      {
        "ext": ["7z"],
        "description": "7-Zip Archive",
        "role": "Viewer"
      },
      {
        "ext": ["rar"],
        "description": "RAR Archive",
        "role": "Viewer"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "android": {
      "minSdkVersion": 24,
      "versionCode": 1
    }
  },
  "plugins": {}
}
